# Discord bot token from https://discord.com/developers/applications
# (optional here: the bot asks for it on first run and saves it)
DISCORD_TOKEN=
# Optional: overrides the Treblo API key built into musicbot/bot.py
TREBLO_API_KEY=

# Optional: your test server's ID so slash commands show up instantly
DEV_GUILD_ID=
# Optional tuning
MAX_CONCURRENT_JOBS=3
USER_COOLDOWN_SECONDS=30
GENERATION_TIMEOUT_SECONDS=600
LOG_LEVEL=INFO
