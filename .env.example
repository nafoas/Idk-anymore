# Discord bot token from https://discord.com/developers/applications
DISCORD_TOKEN=
# Treblo API key from https://treblo.com/developers
TREBLO_API_KEY=

# Optional: your test server's ID so slash commands show up instantly
DEV_GUILD_ID=
# Optional tuning
MAX_CONCURRENT_JOBS=3
USER_COOLDOWN_SECONDS=30
GENERATION_TIMEOUT_SECONDS=600
LOG_LEVEL=INFO
